# Orange TV Docker Compose 环境变量示例
# 使用方式：复制本文件为 .env 并按需修改
#   cp .env.example .env
#
# docker compose up 时会自动读取同目录下的 .env 文件进行变量替换。

# ── 数据库账号（同时注入 MySQL 与 app，两者必须一致）──────────────────────
DB_USER=orange
DB_PASSWORD=orange_password
DB_NAME=orange_tv

# ── MySQL root 密码 ──────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword

# ── JWT 签名密钥 ─────────────────────────────────────────────────────────
# 生产环境必填，至少 32 字节，请务必修改为随机字符串
JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes

# ── 端口映射 ─────────────────────────────────────────────────────────────
HTTP_PORT=80
ADMIN_PORT=81
MYSQL_PORT=3306

# ── 自动迁移 ─────────────────────────────────────────────────────────────
# 设为 true 时，app 容器启动前自动执行 migrate up，无需手动迁移
AUTO_MIGRATE=true
