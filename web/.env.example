# Orange TV 前端环境变量（client / admin 共用，位于 web/）
# 复制为 .env.development.local 或 .env.production.local 可本地覆盖（已 gitignore）

# API 服务 origin（不要带 /api 路径）。留空则：
#   - 开发：走 Vite 代理（同源 /api）
#   - 生产：同源相对路径（由 nginx 反代）
# 示例：https://api.example.com
VITE_API_BASE_URL=

# 开发服务器将 /api（及 client SEO 路径）代理到此地址
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080
