# Application Environment Variables
# Copy this file to .env and update with your actual values

# Application Configuration
APP_NAME=orange-tv
APP_VERSION=1.0.0
APP_ENV=dev

# HTTP Server Configuration
HTTP_ENABLED=true
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Logging Configuration
LOG_LEVEL=info
LOG_OUTPUT=stdout

# Database Configuration (MySQL default)
# These environment variables override values in config.yaml/config.prod.yaml
DATABASE_DRIVER=mysql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=orange
DATABASE_PASSWORD=orange_password
DATABASE_NAME=orange_tv
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=300

# Redis Configuration
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (required in production; set via JWT_SECRET)
# JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Docker Compose related defaults
VERSION=1.0.0
HTTP_PORT=8080
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=orange_tv
MYSQL_USER=orange
MYSQL_PASSWORD=orange_password
MYSQL_PORT=3306
REDIS_PORT=6379
